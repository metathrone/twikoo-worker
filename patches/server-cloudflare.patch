+let handlersHooked = false;
+function hookCommentDeleteHandlers(): void {
+  if (handlersHooked) return;
+  handlersHooked = true;
+  const adminHandler = resolveHandler("COMMENT_DELETE_FOR_ADMIN" as any);
+  if (adminHandler) {
+    registerHandler("COMMENT_DELETE_FOR_ADMIN" as any, (ctx) =>
+      handleCommentDeleteWithCleanup(ctx, adminHandler as any),
+    );
+  }
+  const userHandler = resolveHandler("COMMENT_DELETE_FOR_USER" as any);
+  if (userHandler) {
+    registerHandler("COMMENT_DELETE_FOR_USER" as any, (ctx) =>
+      handleCommentDeleteWithCleanup(ctx, userHandler as any),
+    );
+  }
+}
